# API FastAPI. Em produção o Next usa URL_API_PRODUCAO se esta variável estiver vazia.
# Local (Python na pasta backend): http://localhost:8000
# Produção (Vercel do colega): https://sophia-backend-umber.vercel.app
SOPHIA_BACK_URL=https://sophia-backend-umber.vercel.app

# Não exponha a API no navegador. Deixe vazio — as rotas /api do Next é que chamam o back.
NEXT_PUBLIC_SOPHIA_TRANSCRICAO=

# Segredo que assina o cookie de sessão (HMAC). Obrigatório em produção; gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Sem ele, em desenvolvimento cada reinício do `next dev` encerra as sessões.
SESSION_SECRET=

# Base REST dos casos quando o backend tiver essas rotas. Sem esta variável os
# casos usam as rotas /api/casos do Next (que já falam com SOPHIA_BACK_URL).
NEXT_PUBLIC_API_URL=

# Análise preliminar e chat com IA do backend (módulo `backend/analise`). Ligados por padrão;
# com false, o front usa a análise simulada.
NEXT_PUBLIC_ANALISE_REAL=
